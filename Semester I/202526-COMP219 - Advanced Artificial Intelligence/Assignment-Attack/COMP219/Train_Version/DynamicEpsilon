    model = Net().to(device)
    optimizer = optim.SGD(model.parameters(), lr=args.lr, momentum=0.9)  # 建议加上 momentum=0.9 加速收敛

    best_adv_acc = 0  # 记录最高分

    for epoch in range(1, args.epochs + 1):
        start_time = time.time()
        train(args, model, device, train_loader, optimizer, epoch)
        trnloss, trnacc = eval_test(model, device, train_loader)
        advloss, advacc = eval_adv_test(model, device, train_loader)

        print(f'Epoch {epoch}: ... adv_acc: {100. * advacc:.2f}%')

        # 【新增】保存最佳模型策略
        if advacc > best_adv_acc:
            best_adv_acc = advacc
            print(f"  [New Best] Model saved with Adv Acc: {100. * advacc:.2f}%")
